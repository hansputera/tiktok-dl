{
  "name": "tktk",
  "version": "2.0.0",
  "main": "index.js",
  "private": true,
  "license": "MIT",
  "devDependencies": {
    "husky": "9.1.7",
    "turbo": "2.11.13"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run build --filter=tiktok-dl-core && turbo run dev",
    "lint": "turbo run lint",
    "format": "turbo run format",
    "prepare": "husky install",
    "start": "turbo run start"
  },
  "packageManager": "yarn@4.19.0",
  "engines": {
    "node": ">=14.x"
  },
  "type": "module"
}
